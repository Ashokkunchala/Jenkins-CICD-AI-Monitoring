aws_region           = "us-east-1"
environment          = "dev"
project_name         = "cicd-platform"

# VPC
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# ---- Cost Savings ----
# NAT Gateway: ~$35/mo. Keep false for dev.
enable_nat_gateway = false

# Instance Scheduler: stops instances 6PM-6AM UTC daily. Saves ~60%.
# Disable if you need 24/7 uptime.
enable_instance_scheduler = true
instance_schedule_stop    = "cron(0 18 * * ? *)"   # 6 PM UTC
instance_schedule_start   = "cron(0 6 * * ? *)"    # 6 AM UTC
# --------------------

# Security
allowed_ssh_cidr     = "0.0.0.0/0"

# Jenkins
jenkins_master_instance_type = "t3a.medium"
jenkins_admin_user           = "admin"
jenkins_admin_password       = "changeme123"

# Agent Fleet (Spot instances - cheapest option)
agent_amd64_instance_types = ["t3a.small", "t3a.medium", "t2.medium", "t3a.large"]
agent_arm64_instance_types = ["t4g.medium", "t4g.small", "a1.medium"]
agent_min_target_capacity  = 1
agent_max_target_capacity  = 5

# SonarQube (t3a.small = $0.0188/hr, 2GB RAM enough for dev)
sonarqube_instance_type = "t3a.small"
sonarqube_version       = "10.6.0.9216"

# Nexus (t3a.small = $0.0188/hr)
nexus_instance_type = "t3a.small"
nexus_version       = "3.70.2-01"

# SSH key path
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# ---- AI CI/CD Agent ----
# Email for alerts (leave empty to skip email)
agent_alert_email = "devops@example.com"

# Teams webhook URL for alerts (leave empty to skip Teams)
agent_teams_webhook_url = ""

# GitHub integration for auto-fix PRs (leave empty to skip)
agent_github_token  = ""
agent_github_owner  = ""
agent_github_repo   = ""
