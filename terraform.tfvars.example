aws_region  = "us-east-1"
environment = "dev"
project_name = "cicd-platform"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]
availability_zones   = []

enable_nat_gateway         = false
enable_instance_scheduler  = true
instance_schedule_stop     = "cron(0 18 * * ? *)"
instance_schedule_start    = "cron(0 6 * * ? *)"
vpc_flow_log_retention_days = 30

allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"
allowed_web_cidr = ""

jenkins_master_instance_type = "t3a.medium"
jenkins_admin_user           = "admin"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

agent_amd64_instance_types = ["t3a.small", "t3a.medium", "t2.medium", "t3a.large"]
agent_arm64_instance_types = ["t4g.medium", "t4g.small", "a1.medium"]
agent_min_target_capacity  = 1
agent_max_target_capacity  = 1
agent_spot_allocation_strategy = "capacity-optimized"

sonarqube_instance_type = "t3a.medium"
sonarqube_version       = "10.6.0.9216"

nexus_instance_type = "t3a.large"
nexus_version       = "3.70.2-01"

# AMI pinning. Leaving these empty resolves the current Amazon Linux 2023 AMI,
# which replaces every instance when AWS publishes a new release. Pin them for
# stable plans: aws ssm get-parameter --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
ami_id             = ""
agent_amd64_ami_id = ""
agent_arm64_ami_id = ""

# Detailed one-minute EC2 monitoring is billed per instance-hour. Leave false for dev.
enable_detailed_monitoring = false

# Bootstrap download integrity. Empty strings disable verification; the SonarQube
# host does not serve a checksum file, so publish its hash here to pin it.
maven_sha512      = "a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b"
gradle_sha256     = "544c35d6bd849ae8a5ed0bcea39ba677dc40f49df7d1835561582da2009b961d"
sonarqube_sha256  = ""
nexus_sha256      = "3f7bd2e7e42706af3ffa288a1e9728a3bb33e04470a9c2625e7444299e0a7e87"

agent_alert_email       = ""
agent_teams_webhook_url = ""
agent_github_token      = ""
agent_github_owner      = ""
agent_github_repo       = ""
agent_github_base_branch = "main"
agent_github_auto_fix_enabled = false

bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"
enable_ai_retrain = false
